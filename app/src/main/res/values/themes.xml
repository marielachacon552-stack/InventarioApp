<resources>
    <style name="Base.Theme.InventarioApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pink_primary</item>
        <item name="colorOnPrimary">@color/pink_on_primary</item>
        <item name="colorPrimaryContainer">@color/pink_soft</item>
        <item name="colorOnPrimaryContainer">@color/pink_text</item>
        <item name="colorSecondary">@color/pink_primary</item>
        <item name="colorOnSecondary">@color/pink_on_primary</item>
        <item name="colorSurface">@color/pink_surface</item>
        <item name="colorOnSurface">@color/pink_text</item>
        <item name="colorOnSurfaceVariant">@color/pink_muted</item>
        <item name="colorOutline">@color/pink_border</item>
        <item name="android:colorBackground">@color/pink_background</item>
        <item name="android:windowBackground">@color/pink_background</item>
        <item name="android:textColorPrimary">@color/pink_text</item>
        <item name="android:textColorSecondary">@color/pink_muted</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.Jennifer.Button</item>
    </style>
    <style name="Theme.InventarioApp" parent="Base.Theme.InventarioApp"/>
    <style name="Widget.Jennifer.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item><item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Jennifer.Navigation" parent="Widget.Jennifer.Button">
        <item name="backgroundTint">@color/navigation_background</item>
        <item name="android:textColor">@color/navigation_text</item>
        <item name="cornerRadius">14dp</item><item name="android:textSize">12sp</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:layout_marginHorizontal">2dp</item>
    </style>
    <style name="Widget.Jennifer.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item><item name="strokeColor">@color/pink_border</item>
        <item name="android:textColor">@color/pink_primary</item><item name="android:textAllCaps">false</item>
    </style>
</resources>